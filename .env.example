# Copiá este archivo a ".env" y completá los valores para tu entorno local.
# El archivo ".env" NUNCA debe subirse a GitHub (ya está en .gitignore).

SECRET_KEY=poné-aca-una-clave-secreta-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Dejar vacío en local (se usa SQLite automáticamente).
# En Render, esta variable la completa automáticamente el servicio de base de datos.
DATABASE_URL=

CSRF_TRUSTED_ORIGINS=
